import json
import numpy as np
import matplotlib.pyplot as plt
from scipy import stats
import pandas as pd

def extract_hate_intensity_data_by_identity():
    """Extract hate intensity data from all platforms, separated by racial identity groups"""
    # Focus only on the five racial identity groups
    racial_groups = ["african_americans", "east_asian", "south_asian", "latino", "jewish"]
    
    # Initialize data structure for all platforms and racial groups
    platforms_data = {}
    for platform in ["4chan", "gab", "stormfront", "vanguard"]:
        platforms_data[platform] = {}
        for group in racial_groups:
            platforms_data[platform][group] = {"main": [], "avg_reply": []}
    
    # Process 4chan data
    print("Processing 4chan data...")
    with open("4chan_data.json", "r", encoding="utf-8") as f:
        data = json.load(f)
    
    for thread in data:
        main_hate = thread.get("hate_intensity")
        if main_hate is not None:
            # Calculate average reply hate intensity
            reply_scores = []
            for reply in thread.get("replies", []):
                if reply.get("hate_intensity") is not None:
                    reply_scores.append(reply["hate_intensity"])
            
            if reply_scores:  # Only include threads with replies
                avg_reply_hate = np.mean(reply_scores)
                
                # Get identity tags
                identity_tags = thread.get("tag", [])
                
                # Check if any racial identity tags are present
                racial_tags = [tag for tag in identity_tags if tag in racial_groups]
                
                # Add this thread to each of its racial identity groups
                for tag in racial_tags:
                    platforms_data["4chan"][tag]["main"].append(main_hate)
                    platforms_data["4chan"][tag]["avg_reply"].append(avg_reply_hate)
    
    # Process Gab data
    print("Processing Gab data...")
    with open("gab_data.json", "r", encoding="utf-8") as f:
        data = json.load(f)
    
    for thread in data:
        main_hate = thread.get("hate_intensity")
        if main_hate is not None:
            # Calculate average reply hate intensity
            reply_scores = []
            for reply in thread.get("replies", []):
                if reply.get("hate_intensity") is not None:
                    reply_scores.append(reply["hate_intensity"])
            
            if reply_scores:  # Only include threads with replies
                avg_reply_hate = np.mean(reply_scores)
                
                # Get identity tags
                identity_tags = thread.get("tag", [])
                
                # Check if any racial identity tags are present
                racial_tags = [tag for tag in identity_tags if tag in racial_groups]
                
                # Add this thread to each of its racial identity groups
                for tag in racial_tags:
                    platforms_data["gab"][tag]["main"].append(main_hate)
                    platforms_data["gab"][tag]["avg_reply"].append(avg_reply_hate)
    
    # Process Stormfront data
    print("Processing Stormfront data...")
    with open("revolution_stormfront.json", "r", encoding="utf-8") as f:
        data = json.load(f)
    
    for thread in data.values():
        # For Stormfront, we need to calculate main post hate intensity from scraped_replies
        reply_scores = []
        for reply in thread.get("scraped_replies", []):
            if reply.get("hate_intensity") is not None:
                reply_scores.append(reply["hate_intensity"])
        
        if len(reply_scores) > 1:  # Need at least 2 replies to separate main from others
            # Use first reply as main post (common pattern in forum data)
            main_hate = reply_scores[0]
            avg_reply_hate = np.mean(reply_scores[1:])  # Average of remaining replies
            
            # Get identity tags
            identity_tags = thread.get("tag", [])
            
            # Check if any racial identity tags are present
            racial_tags = [tag for tag in identity_tags if tag in racial_groups]
            
            # Add this thread to each of its racial identity groups
            for tag in racial_tags:
                platforms_data["stormfront"][tag]["main"].append(main_hate)
                platforms_data["stormfront"][tag]["avg_reply"].append(avg_reply_hate)
    
    # Process Vanguard data
    print("Processing Vanguard data...")
    with open("revolution_vanguard.json", "r", encoding="utf-8") as f:
        data = json.load(f)
    
    for thread in data.values():
        # Similar approach for Vanguard
        reply_scores = []
        for reply in thread.get("scraped_replies", []):
            if reply.get("hate_intensity") is not None:
                reply_scores.append(reply["hate_intensity"])
        
        if len(reply_scores) > 1:  # Need at least 2 replies to separate main from others
            # Use first reply as main post
            main_hate = reply_scores[0]
            avg_reply_hate = np.mean(reply_scores[1:])  # Average of remaining replies
            
            # Get identity tags
            identity_tags = thread.get("tag", [])
            
            # Check if any racial identity tags are present
            racial_tags = [tag for tag in identity_tags if tag in racial_groups]
            
            # Add this thread to each of its racial identity groups
            for tag in racial_tags:
                platforms_data["vanguard"][tag]["main"].append(main_hate)
                platforms_data["vanguard"][tag]["avg_reply"].append(avg_reply_hate)
    
    return platforms_data

def create_regression_plots_by_identity(platforms_data):
    """Create separate regression plots for each platform with lines for racial identity groups, combined, and other.
    Also print APA-formatted regression statistics table to the console."""
    import pandas as pd
    import matplotlib.pyplot as plt
    platform_names = ["4chan", "gab", "stormfront", "vanguard"]
    racial_groups = ["african_americans", "east_asian", "south_asian", "latino", "jewish"]
    
    # Define colors for different racial identity groups
    colors = {
        'african_americans': '#1f77b4', 'east_asian': '#ff7f0e', 'south_asian': '#2ca02c', 
        'latino': '#d62728', 'jewish': '#9467bd', 'combined': '#222222', 'other': '#8c564b'
    }
    
    # Define markers for different racial identity groups
    markers = {
        'african_americans': 'o', 'east_asian': 's', 'south_asian': '^', 
        'latino': 'D', 'jewish': 'v', 'combined': 'X', 'other': '<'
    }

    # Collect regression stats for APA table
    apa_stats = []
    
    for platform in platform_names:
        fig, ax = plt.subplots(figsize=(8, 6))
        has_data = False
        for group in platforms_data[platform].keys():
            if platforms_data[platform][group]["main"]:
                has_data = True
                break
        if not has_data:
            ax.text(0.5, 0.5, f'No data for {platform}', ha='center', va='center', transform=ax.transAxes)
            ax.set_title(f'{platform.upper()}', fontsize=14)
            plt.show()
            continue
        # Plot each racial identity group
        for group in racial_groups:
            main_scores = platforms_data[platform][group]["main"]
            avg_reply_scores = platforms_data[platform][group]["avg_reply"]
            if main_scores and len(main_scores) > 1:
                # ax.scatter(main_scores, avg_reply_scores, ...)
                slope, intercept, r_value, p_value, std_err = stats.linregress(main_scores, avg_reply_scores)
                x_vals = np.array([min(main_scores), max(main_scores)])
                y_vals = intercept + slope * x_vals
                ax.plot(x_vals, y_vals, color=colors.get(group, '#000000'), linestyle='-', linewidth=2, label=f'{group.replace("_", " ").title()}')
                n = len(main_scores)
                p = 1
                r2 = float(r_value) ** 2
                adj_r2 = 1 - (1 - r2) * (n - 1) / (n - p - 1) if n > 2 else r2
                effect_size_r = abs(r_value)
                effect_size_f2 = r2 / (1 - r2) if r2 < 1 else float('inf')
                apa_stats.append({
                    'Platform': platform,
                    'Group': group,
                    'n': n,
                    'Slope (b)': slope,
                    'Intercept (a)': intercept,
                    'R²': r2,
                    'Adjusted R²': adj_r2,
                    'p': p_value,
                    '|r|': effect_size_r,
                    "Cohen's f²": effect_size_f2
                })
        # Add combined regression for all five racial groups
        combined_main = []
        combined_reply = []
        for group in racial_groups:
            combined_main.extend(platforms_data[platform][group]["main"])
            combined_reply.extend(platforms_data[platform][group]["avg_reply"])
        if combined_main and len(combined_main) > 1:
            slope, intercept, r_value, p_value, std_err = stats.linregress(combined_main, combined_reply)
            x_vals = np.array([min(combined_main), max(combined_main)])
            y_vals = intercept + slope * x_vals
            ax.plot(x_vals, y_vals, color=colors['combined'], linestyle='-', linewidth=3, label=f'Combined')
            n = len(combined_main)
            p = 1
            r2 = float(r_value) ** 2
            adj_r2 = 1 - (1 - r2) * (n - 1) / (n - p - 1) if n > 2 else r2
            effect_size_r = abs(r_value)
            effect_size_f2 = r2 / (1 - r2) if r2 < 1 else float('inf')
            apa_stats.append({
                'Platform': platform,
                'Group': 'combined',
                'n': n,
                'Slope (b)': slope,
                'Intercept (a)': intercept,
                'R²': r2,
                'Adjusted R²': adj_r2,
                'p': p_value,
                '|r|': effect_size_r,
                "Cohen's f²": effect_size_f2
            })
        ax.set_title(f'{platform.upper()}', fontsize=16)
        ax.set_xlabel('Main Post Hate Intensity', fontsize=14)
        ax.set_ylabel('Average Reply Hate Intensity', fontsize=14)
        ax.legend(fontsize=10, loc='best')
        plt.tight_layout()
        plt.show()

    # Print APA-formatted regression statistics table
    if apa_stats:
        df = pd.DataFrame(apa_stats)
        # Format columns APA style
        df['Slope (b)'] = df['Slope (b)'].map(lambda x: f"{x:.2f}")
        df['Intercept (a)'] = df['Intercept (a)'].map(lambda x: f"{x:.2f}")
        df['R²'] = df['R²'].map(lambda x: f"{x:.2f}")
        df['Adjusted R²'] = df['Adjusted R²'].map(lambda x: f"{x:.2f}")
        df['p'] = df['p'].map(lambda x: f"{x:.3f}")
        df['|r|'] = df['|r|'].map(lambda x: f"{x:.2f}")
        df["Cohen's f²"] = df["Cohen's f²"].map(lambda x: f"{x:.2f}" if x != float('inf') else 'inf')
        df['n'] = df['n'].astype(int)
        print("\nAPA-Formatted Regression Statistics Table:")
        print(df.to_string(index=False))

def create_regression_plots_virality_by_identity(platforms_data, thread_data):
    """Create regression plots for each platform with lines for racial identity groups, combined, and other.
    X = main post hate intensity, Y = virality metric.
    Also print APA-formatted regression statistics table to the console."""
    import pandas as pd
    import matplotlib.pyplot as plt
    platform_names = ["4chan", "gab", "stormfront", "vanguard"]
    racial_groups = ["african_americans", "east_asian", "south_asian", "latino", "jewish"]
    
    # Define colors for different racial identity groups
    colors = {
        'african_americans': '#1f77b4', 'east_asian': '#ff7f0e', 'south_asian': '#2ca02c', 
        'latino': '#d62728', 'jewish': '#9467bd', 'combined': '#222222', 'other': '#8c564b'
    }
    
    # Collect regression stats for APA table
    apa_stats = []
    
    for platform in platform_names:
        fig, ax = plt.subplots(figsize=(8, 6))
        has_data = False
        # For each group, collect (main_hate, virality) pairs
        group_data = {g: {'x': [], 'y': []} for g in racial_groups}
        # Also for combined
        group_data['combined'] = {'x': [], 'y': []}
        # Go through all threads for this platform
        for thread in thread_data[platform]:
            tags = thread.get('tag', [])
            main_hate = thread.get('main_hate')
            virality = thread.get('virality')
            if main_hate is None or virality is None:
                continue
            # Check for racial tags
            racial_tags = [t for t in tags if t in racial_groups]
            if racial_tags:
                for t in racial_tags:
                    group_data[t]['x'].append(main_hate)
                    group_data[t]['y'].append(virality)
                # Add to combined
                group_data['combined']['x'].append(main_hate)
                group_data['combined']['y'].append(virality)
        # Plot and fit regression for each group
        for group in racial_groups + ["combined"]:
            x = group_data[group]['x']
            y = group_data[group]['y']
            if x and len(x) > 1:
                has_data = True
                slope, intercept, r_value, p_value, std_err = stats.linregress(x, y)
                x_vals = np.array([min(x), max(x)])
                y_vals = intercept + slope * x_vals
                ax.plot(x_vals, y_vals, color=colors.get(group, '#000000'), linestyle='-', linewidth=2 if group != 'combined' else 3, label=f'{group.replace("_", " ").title()}')
                n = len(x)
                p = 1
                r2 = float(r_value) ** 2
                adj_r2 = 1 - (1 - r2) * (n - 1) / (n - p - 1) if n > 2 else r2
                effect_size_r = abs(r_value)
                effect_size_f2 = r2 / (1 - r2) if r2 < 1 else float('inf')
                apa_stats.append({
                    'Platform': platform,
                    'Group': group,
                    'n': n,
                    'Slope (b)': slope,
                    'Intercept (a)': intercept,
                    'R²': r2,
                    'Adjusted R²': adj_r2,
                    'p': p_value,
                    '|r|': effect_size_r,
                    "Cohen's f²": effect_size_f2
                })
        if not has_data:
            ax.text(0.5, 0.5, f'No data for {platform}', ha='center', va='center', transform=ax.transAxes)
            ax.set_title(f'{platform.upper()}', fontsize=14)
            plt.show()
            continue
        ax.set_title(f'{platform.upper()}', fontsize=16)
        ax.set_xlabel('Main Post Hate Intensity', fontsize=14)
        ax.set_ylabel('Virality Metric', fontsize=14)
        ax.legend(fontsize=10, loc='best')
        plt.tight_layout()
        plt.show()
    # Print APA-formatted regression statistics table
    if apa_stats:
        df = pd.DataFrame(apa_stats)
        # Format columns APA style
        df['Slope (b)'] = df['Slope (b)'].map(lambda x: f"{x:.2f}")
        df['Intercept (a)'] = df['Intercept (a)'].map(lambda x: f"{x:.2f}")
        df['R²'] = df['R²'].map(lambda x: f"{x:.2f}")
        df['Adjusted R²'] = df['Adjusted R²'].map(lambda x: f"{x:.2f}")
        df['p'] = df['p'].map(lambda x: f"{x:.3f}")
        df['|r|'] = df['|r|'].map(lambda x: f"{x:.2f}")
        df["Cohen's f²"] = df["Cohen's f²"].map(lambda x: f"{x:.2f}" if x != float('inf') else 'inf')
        df['n'] = df['n'].astype(int)
        # Save as TSV file
        tsv_path = 'regression_stats_virality.tsv'
        df.to_csv(tsv_path, sep='\t', index=False, encoding='utf-8')
        print(f"\nAPA-Formatted Regression Statistics Table (Virality vs. Hate Intensity) saved as: {tsv_path}\nYou can import this file into Google Docs or Excel for proper table formatting.")

# To use this, you need to prepare thread_data[platform] as a list of threads for each platform,
# with 'main_hate' and 'virality' fields extracted for each thread.

def main():
    """Main function"""
    print("Extracting hate intensity data from all platforms by racial identity group...")
    platforms_data = extract_hate_intensity_data_by_identity()
    
    print("\nCreating regression plots by racial identity group...")
    create_regression_plots_by_identity(platforms_data)
    
    print("\nAnalysis complete! Check 'regression_analysis_racial_identity.png' for the plots.")

if __name__ == "__main__":
    main() 
